@@ -74,7 +74,10 @@ WebSocket.prototype.supportsFraming = true;
  * @api private
  */
 
-WebSocket.prototype.onData = function (data) {
+WebSocket.prototype.onData = function (data, isBinary) {
+  // Bun's ws adapter returns a Buffer for text frames, with isBinary=false.
+  // Engine.IO 3 distinguishes text packets from binary packets by JS type.
+  if (isBinary === false && Buffer.isBuffer(data)) data = data.toString('utf8');
   debug('received "%s"', data);
   Transport.prototype.onData.call(this, data);
 };
